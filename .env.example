# Browser PocketBase proxy path.
VITE_POCKETBASE_URL=/api/db

# Server-side PocketBase endpoint and service credentials.
POCKETBASE_URL=
PRIVATE_POCKETBASE_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Printer configuration.
PRIVATE_PRINTER_NAME=
PRIVATE_TEACHER_PRINTER_NAME=
PRIVATE_TEMP_DIR=
PRIVATE_DEFAULT_QUOTA_PAGES=
PRIVATE_GRACE_PERIOD_MS=
PRIVATE_MISSING_JOB_AGE_MS=

# Optional support link and reverse-proxy settings.
DISCORD_LINK=
TRUST_PROXY=false

# Upload request limit, including multipart overhead; also shown in the upload form.
BODY_SIZE_LIMIT=50M
